# Copy to .env  (Option B development mode). Docker Compose sets its own values.
DATABASE_URL=postgresql+psycopg2://certgen:certgen@localhost:5432/certgen
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage
API_KEYS=dev-secret-key
PUBLIC_BASE_URL=http://localhost:8000
MAX_RECIPIENTS_PER_REQUEST=5000
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2
PROCESSING_TIMEOUT_SECONDS=300
# true = run tasks inline inside the API process (no Redis/worker needed). Lite mode + tests.
CELERY_EAGER=false
